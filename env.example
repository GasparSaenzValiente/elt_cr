# =============================================================================
# CAMBIOS respecto al .env.example original:
#   - Unificado con env.example.txt (había dos archivos distintos, ahora uno solo)
#   - Agregadas las variables de credenciales que antes estaban hardcodeadas
#     en docker-compose.yaml
#   - Agregadas las variables AIRFLOW_FERNET_KEY y JWT secrets
#   - Instrucciones de generación para cada clave sensible
#   - Renombrado el archivo final a .env.example (estándar de la industria)
# =============================================================================
# USO: cp .env.example .env  y completar los valores marcados con <...>
# =============================================================================

# --- airflow config ---
AIRFLOW_UID=50000
# Ejecutar en Linux: echo "AIRFLOW_UID=$(id -u)" >> .env
AIRFLOW_PROJ_DIR=.

# --- airflow ui credentials ---
AIRFLOW_WWW_USER_USERNAME=airflow
AIRFLOW_WWW_USER_PASSWORD=<AIRFLOW_UI_PASSWORD>

# --- airflow metadata database (postgres interno de airflow) ---
AIRFLOW_POSTGRES_USER=airflow
AIRFLOW_POSTGRES_PASSWORD=<AIRFLOW_POSTGRES_PASSWORD>
AIRFLOW_POSTGRES_DB=airflow

# --- airflow security keys ---
# Generar fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=<GENERATED_FERNET_KEY>

# --- clash royale data warehouse (postgres de negocio) ---
CR_POSTGRES_USER=cr_user
CR_POSTGRES_PASSWORD=<CR_POSTGRES_PASSWORD>
CR_POSTGRES_DB=cr_db

# --- clash royale api key ---
# Obtener en: https://developer.clashroyale.com/
CLASH_API_KEY=<API_KEY>

# --- minio data lake ---
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=<MINIO_PASSWORD>

# --- airflow connections (configuradas automáticamente al levantar) ---
# formato: type://user:password@host:port/schema?extras

# MinIO data lake (usar las mismas credenciales que MINIO_ROOT_USER/PASSWORD)
AIRFLOW_CONN_MINIO_S3_CONN=aws://admin:<MINIO_PASSWORD>@minio:9000?endpoint_url=http%3A%2F%2Fminio%3A9000

# Postgres data warehouse (usar las mismas credenciales que CR_POSTGRES_USER/PASSWORD)
AIRFLOW_CONN_POSTGRES_CR_DW=postgresql://cr_user:<CR_POSTGRES_PASSWORD>@db:5432/cr_db

# --- vip players & clans (opcional) ---
# Agregar tags de jugadores/clanes VIP para seguimiento prioritario.
# Si no se configura, el pipeline solo trackea los top clanes globales.
AIRFLOW_VAR_CR_TRACKING_CONFIG='{"players": ["#PLAYER_TAG_1", "#PLAYER_TAG_2"], "clans": ["#CLAN_TAG_1"]}'
